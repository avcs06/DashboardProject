{"at":"2026-11-04T19:23:14.485Z","tool":"bash","command":"cat > ./probe-toast.mjs <<'EOF'\nimport { chromium } from 'playwright-core';\nimport { readFileSync } from 'node:fs';\nconst storage = JSON.parse(readFileSync('.weave/02-contract/signed-in.json', 'utf8'));\nconst browser = await chromium.launch();\nconst page = await browser.newPage({ viewport: { width: 1280, height: 900 } });\nawait page.addInitScript((e) => { for (const [k, v] of Object.entries(e)) localStorage.setItem(k, v); }, storage);\nawait page.goto('http://localhost:3001/dashboards/dashboard-1', { waitUntil: 'load' });\nawait page.getByRole('button', { name: /Increase/ }).first().click();\nconst toast = page.locator('[data-sonner-toast]');\nawait toast.first().waitFor({ timeout: 8000 }).catch(() => {});\nconsole.log('toast count:', await toast.count());\nconsole.log('toast text:', JSON.stringify(await toast.first().textContent().catch(() => null)));\nawait browser.close();\nEOF\nnode ./probe-toast.mjs 2>&1 | tail -5; rm -f ./probe-toast.mjs"}
{"at":"2026-11-04T19:23:26.599Z","tool":"bash","command":"cat > ./probe-toast2.mjs <<'EOF'\nimport { chromium } from 'playwright-core';\nimport { readFileSync } from 'node:fs';\nconst storage = JSON.parse(readFileSync('.weave/02-contract/signed-in.json', 'utf8'));\nconst browser = await chromium.launch();\nconst page = await browser.newPage({ viewport: { width: 1280, height: 900 } });\nawait page.addInitScript((e) => { for (const [k, v] of Object.entries(e)) localStorage.setItem(k, v); }, storage);\nawait page.goto('http://localhost:3001/dashboards/dashboard-1', { waitUntil: 'load' });\nawait page.waitForTimeout(1500);\nawait page.getByRole('button', { name: /Increase/ }).first().click();\nawait page.waitForTimeout(1500);\nconst body = await page.content();\nconsole.log('has Change saved:', body.includes('Change saved'));\nconst alerts = await page.locator('[role=\"status\"], [role=\"alert\"], [aria-live]').allTextContents();\nconsole.log('live regions:', JSON.stringify(alerts));\nawait browser.close();\nEOF\nnode ./probe-toast2.mjs 2>&1 | tail -5; rm -f ./probe-toast2.mjs"}
