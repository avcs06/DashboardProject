{
  "brief": {
    "audience": "Individuals who want one private, personal place for their own notes, counters, checklists and useful links, visited often to quickly check and update small everyday things.",
    "personality": [
      "bold",
      "electric",
      "focused",
      "theatrical"
    ],
    "voice": "plain, energised, second person",
    "density": "comfortable",
    "signature": "A faint neon grid behind every page, and glowing teal figures in the mono font",
    "feel": [
      "neon",
      "squared"
    ],
    "colorScheme": "dark",
    "seedHue": 195,
    "seedChroma": "vivid",
    "frameHue": 266,
    "frameChroma": "balanced",
    "baseHue": 195,
    "baseChroma": "muted",
    "statusHues": {
      "success": 164,
      "warning": 84,
      "error": 29,
      "info": 246
    },
    "fonts": {
      "ui": [
        {
          "family": "Exo 2",
          "reason": "Techy but readable sans with organic forms, futuristic without sacrificing widget text legibility."
        },
        {
          "family": "Titillium Web",
          "reason": "Squarish semi-technical sans from Italy that suits a squared console interface and everyday UI text."
        },
        {
          "family": "Manrope",
          "reason": "Clean modern geometric-grotesque that keeps forms and lists calm and highly readable."
        }
      ],
      "display": [
        {
          "family": "Orbitron",
          "reason": "Squared sci-fi letterforms give page titles the spaceship-console character the brief asks for."
        },
        {
          "family": "Space Grotesk",
          "reason": "Quirky techy grotesque that feels futuristic while staying calmer than Orbitron at smaller heading sizes."
        },
        {
          "family": "Chakra Petch",
          "reason": "Squared Thai-Latin sans with a technical console feel that suits headings and labels."
        }
      ],
      "mono": [
        {
          "family": "Space Mono",
          "reason": "Retro-futurist computer type that makes counter figures, counts and timestamps glow like terminal readouts."
        },
        {
          "family": "JetBrains Mono",
          "reason": "Tall, clear monospace with even figures for counters, ids and last-edited times."
        },
        {
          "family": "IBM Plex Mono",
          "reason": "Engineered monospace that keeps figures aligned and legible in dense widget data."
        }
      ]
    },
    "radius": "sharp",
    "focusRing": "glow",
    "entities": [
      {
        "noun": "Dashboard",
